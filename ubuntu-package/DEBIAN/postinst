#!/bin/sh
set -e

DKMS_NAME=surfacepro7-camera-ir
DKMS_VER=@VERSION@

case "$1" in
configure)
	systemd-sysusers surfacepro7-camera.conf

	if ! dkms status -m "$DKMS_NAME" -v "$DKMS_VER" | grep -q .; then
		dkms add -m "$DKMS_NAME" -v "$DKMS_VER"
	fi
	# Build for the running kernel; DKMS rebuilds on kernel updates and
	# signs the modules with the machine owner key (Secure Boot).
	if ! dkms install -m "$DKMS_NAME" -v "$DKMS_VER" -k "$(uname -r)"; then
		echo "WARNING: building the camera drivers for $(uname -r) failed." >&2
		echo "         Are the kernel headers installed? See 'dkms status'." >&2
	fi

	udevadm control --reload || true
	udevadm trigger --subsystem-match=dma_heap || true
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
	fi
	for unit in sp7-camera.service sp7-camerad.service; do
		deb-systemd-helper unmask "$unit" >/dev/null || true
		deb-systemd-helper enable "$unit" >/dev/null || true
	done

	echo
	if ! sp7-camera-firmware --check >/dev/null 2>&1; then
		echo "Surface Pro 7 camera: the ISP firmware is not installed yet."
		echo "  Install it with:  sudo sp7-camera-firmware"
	fi
	if command -v mokutil >/dev/null && mokutil --sb-state 2>/dev/null | grep -q enabled \
	   && [ -f /var/lib/shim-signed/mok/MOK.der ] \
	   && ! mokutil --test-key /var/lib/shim-signed/mok/MOK.der 2>/dev/null | grep -q "already enrolled"; then
		echo "Secure Boot is on and the module signing key is not enrolled yet."
		echo "  Enroll it with:  sudo mokutil --import /var/lib/shim-signed/mok/MOK.der"
		echo "  then reboot and confirm it in the blue MOK manager screen."
	fi
	echo "Reboot to activate the cameras (the drivers are never reloaded at runtime)."
	;;
esac

exit 0
