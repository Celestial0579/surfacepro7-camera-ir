#!/bin/sh
# systemd system-sleep hook (/usr/lib/systemd/system-sleep/sp7-camera).
#
# The IPU4P ISYS driver refuses to suspend while a stream runs, which aborts
# suspend for the whole machine (e.g. lid closed during a video call). Ask
# sp7-camerad to release the sensor before sleep and wait until its libcamera
# child is gone; after resume let it restart the camera if an app still uses it.
#   $1 = pre|post, $2 = suspend|hibernate|hybrid-sleep|suspend-then-hibernate

UNIT=sp7-camerad.service
systemctl -q is-active "$UNIT" || exit 0
MAIN=$(systemctl show -p MainPID --value "$UNIT")
[ -n "$MAIN" ] && [ "$MAIN" != 0 ] || exit 0

case "$1" in
pre)
	kill -USR1 "$MAIN" 2>/dev/null || exit 0
	# up to 5 s for the camera child process to exit
	i=0
	while [ $i -lt 50 ] && pgrep -P "$MAIN" >/dev/null; do
		sleep 0.1
		i=$((i + 1))
	done
	;;
post)
	kill -USR2 "$MAIN" 2>/dev/null
	;;
esac
exit 0
